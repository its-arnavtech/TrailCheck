# Copy to backend/trailcheck-api/.env (or backend/.env) and fill in local values.
# Both files are gitignored. Do not commit them and do not put these secrets in the frontend.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trailcheck?schema=public
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
PORT=3001

# Live National Park Service alerts. Leave blank to return an empty alert list.
NPS_API_KEY=

# DeepSeek is the middle step of the AI chain (DeepSeek V4.1 Flash).
# Leave the key blank to use the rules summary. The key is read only on the server.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Calls per UTC day. After this, ask/digest use the rules summary. 0 disables DeepSeek.
DEEPSEEK_DAILY_LIMIT=100
# Capped in code at 384 even if this value is higher.
DEEPSEEK_MAX_OUTPUT_TOKENS=256

# Per-IP or per-signed-in-user limit for POST /ai/ask and the park digest route.
AI_RATE_LIMIT=20
AI_RATE_LIMIT_TTL_SECONDS=60

# The local QLoRA model runs only when this is true AND a model server or adapter is available.
# Leave this false unless you are running the Python model server yourself.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_TRANSPORT=server
LOCAL_MODEL_SERVER_URL=http://127.0.0.1:8001
LOCAL_MODEL_PYTHON_BIN=python
LOCAL_MODEL_SCRIPT=ml/inference/generate_local.py
LOCAL_MODEL_CONFIG=ml/configs/trailcheck_qlora_4060.yaml
LOCAL_MODEL_ADAPTER_PATH=ml/models/trailcheck-qwen25-3b-json
LOCAL_MODEL_TIMEOUT_MS=180000

PASSWORD_RESET_EMAIL_PROVIDER=disabled
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MIN_RESPONSE_MS=350
MAIL_FROM_ADDRESS=
RESEND_API_KEY=
